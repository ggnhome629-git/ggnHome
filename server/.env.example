# GgnHome API: every setting the server reads. Copy to .env locally, or set these on the host.
# Required ones are marked REQUIRED; the server stops in production if they are missing (see config/validateEnv.js).

NODE_ENV=production
PORT=5000

# ---- Database (REQUIRED) ---------------------------------------------------------------------------
# Several databases for failover: MONGO_URI first, then MONGO_URI_2, MONGO_URI_3 ... They must hold the same data
# (a replica set, or standby clusters you keep in sync). The API moves to the next one if the current one stays down.
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/ggnhome
#MONGO_URI_2=mongodb+srv://user:password@cluster-standby.example.mongodb.net/ggnhome
#MONGO_MAX_POOL_SIZE=10        # connections per server. (servers x this) must stay below your plan's limit
#MONGO_MIN_POOL_SIZE=2
#MONGO_FAILOVER_AFTER_MS=30000 # how long a database may stay down before moving to the next one

# ---- Login tokens (REQUIRED) -----------------------------------------------------------------------
ACCESS_TOKEN_SECRET=change-me-long-random
REFRESH_TOKEN_SECRET=change-me-another-long-random
ACCESS_TOKEN_SECRET_EXPIRE=1h
REFRESH_TOKEN_SECRET_EXPIRE=7d
#ACCESS_TOKEN_AGENT_SECRET=      # optional, defaults to ACCESS_TOKEN_SECRET
#REFRESH_TOKEN_AGENT_SECRET=

# ---- Website addresses -----------------------------------------------------------------------------
# Origins allowed to call the API (comma separated). Default: https://www.ggnhome.com and https://ggnhome.com
ALLOWED_ORIGINS=https://www.ggnhome.com,https://ggnhome.com
# The API's own public address, used in app download links
PUBLIC_API_BASE_URL=https://api.ggnhome.com

# ---- Photos: Cloudinary (add as many accounts as you need) -----------------------------------------
# Uploads rotate across the accounts and skip one that is over its quota. Number the extra accounts _2, _3 ...
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
#CLOUDINARY_CLOUD_NAME_2=
#CLOUDINARY_API_KEY_2=
#CLOUDINARY_API_SECRET_2=
#CLOUDINARY_COOLDOWN_MS=600000      # how long an account that hit its limit is skipped
#CLOUDINARY_UPLOAD_TIMEOUT_MS=60000

# ---- Redis (optional, recommended with more than one server) ---------------------------------------
# Shared read cache and shared rate-limit counters. Without it the API still works: rate limits use MongoDB.
#REDIS_URL=rediss://default:password@host:6379

# ---- Limits ----------------------------------------------------------------------------------------
#MAX_PAGE_SIZE=200                  # the biggest page any list request can ask for

# ---- Scheduled jobs and cache ----------------------------------------------------------------------
CRON_SECRET=change-me-for-the-/api/cron-endpoints
#DISABLE_CRON=true                  # set on servers that should not run the nightly jobs (the jobs also lock, so this is optional)
#AUTO_CACHE_CLEAR_ON_DEPLOY=false   # default: every new deploy clears browser, Redis and Cloudflare caches once
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ZONE_ID=

# ---- Email, SMS, push, places ----------------------------------------------------------------------
#BREVO_API_KEY=
#SENDER_EMAIL=
#SENDER_NAME=GgnHome
#SMS_KEY=                           # shared with the SMS Service app
#LOCATIONIQ_KEY=
# Optional: a separate LocationIQ key restricted to your site domains in the
# LocationIQ dashboard. It is sent to browsers for the quest's 3D map tiles;
# without it the map uses keyless OpenFreeMap tiles.
#LOCATIONIQ_PUBLIC_KEY=
#FIREBASE_SERVICE_ACCOUNT=          # JSON of the service account (push notifications)

# ---- App update prompt -----------------------------------------------------------------------------
#APP_LATEST_VERSION=1.0.0
#APP_MIN_VERSION=1.0.0
#APP_UPDATE_URL=https://www.ggnhome.com/apps
