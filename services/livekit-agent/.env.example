# Credentials for your self-hosted LiveKit server. Keep secrets out of git.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-a-long-random-secret

# Speech providers: "groq" (hosted, fast, free tier - recommended) or "local".
VOICE_STT_PROVIDER=groq
# TTS: deepgram | cartesia | sarvam | groq | local. For the most human voice try
# deepgram (Aura-2) or cartesia (Sonic-3); sarvam suits Indian English / Hindi.
VOICE_TTS_PROVIDER=groq
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_VOICE_ID=
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=
# Dedicated Groq key for speech only (not the consultant's GROQ_API_KEY_* keys).
GROQ_SPEECH_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
# Characters of a reply that are spoken (the full answer stays on screen).
VOICE_MAX_SPEAK_CHARS=320
# Groq rewrites each reply into natural spoken wording (see voice_style_guide.md).
# Rejected automatically if it adds numbers/contacts; set to off to disable.
VOICE_REWRITE=on
VOICE_REWRITE_MODEL=llama-3.1-8b-instant
VOICE_REWRITE_TIMEOUT_S=2.5

# Only used when a provider above is "local": OpenAI-compatible LOCAL speech services. No cloud API keys are required.
# Speaches/faster-whisper server (STT), usually listening on port 8000:
LOCAL_STT_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_STT_API_KEY=local
LOCAL_STT_MODEL=Systran/faster-whisper-small

# Kokoro-FastAPI (TTS), usually listening on port 8880:
LOCAL_TTS_BASE_URL=http://127.0.0.1:8880/v1
LOCAL_TTS_API_KEY=local
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_heart

# A quiet session warns, then hangs up, so it frees a concurrent-session slot
# and stops using plan minutes.
VOICE_IDLE_WARN_S=120
VOICE_IDLE_END_S=150

# CPU load (0-1) above which the worker refuses new visitors.
LIVEKIT_LOAD_THRESHOLD=0.92

LOG_LEVEL=INFO
