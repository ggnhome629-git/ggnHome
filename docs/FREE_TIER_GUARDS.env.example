# GgnHome free-tier safety guards.
# Keep these defaults unless the provider account's plan/quotas have been verified.
# MongoDB Atlas connection budget: code hard-caps this at 5 per API process.
MONGO_MAX_POOL_SIZE=5

# Rate-limit counters use MongoDB by default to preserve Upstash commands.
# Only set true if Redis usage has been budgeted and monitored.
RATE_LIMIT_USE_REDIS=false

# Groq text consultant: shared MongoDB counters; code hard-caps at these values.
# The caps intentionally use roughly half the documented free quota to leave room
# for fixed-window boundaries and other traffic in the same organization.
GROQ_RPM_LIMIT=12
GROQ_RPD_LIMIT=450
GROQ_TPM_LIMIT=3500
GROQ_TPD_LIMIT=90000

# Brevo: 40 recipients per 6-hour bucket, a conservative cap below the free plan.
BREVO_SENDS_PER_6H_LIMIT=40

# Cloudinary: pause uploads at 80% of reported account credits.
CLOUDINARY_SOFT_LIMIT_PERCENT=80
# Multi-account rotation is disabled in code to avoid treating free accounts
# as quota multipliers. Use one primary account for each upload path.

# Live voice: bounded Redis queue, low polling, and a shared daily session budget.
VOICE_QUEUE_ENABLED=true
VOICE_QUEUE_MAX_ACTIVE=2
VOICE_QUEUE_MAX_WAITING=2
VOICE_QUEUE_LEASE_SECONDS=180
VOICE_QUEUE_WAIT_TTL_SECONDS=900
VOICE_SESSIONS_PER_6H_LIMIT=2
VOICE_MAX_TTS_PER_SESSION=8
VOICE_MAX_STT_UTTERANCES_PER_SESSION=30

# Third-party SMS-Gate stays disabled unless its actual free plan is verified.
SMS_GATEWAY_FREE_TIER_CONFIRMED=false
SMS_GATEWAY_SENDS_PER_6H_LIMIT=30

# Server-side NoBroker verification is limited to 50 records per run, >=2s delay.
NOBROKER_SYNC_MAX_LISTINGS_PER_RUN=50
NOBROKER_SYNC_DELAY_MS=2000
