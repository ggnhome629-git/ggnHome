# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ggnhome
MONGODB_USER=
MONGODB_PASSWORD=

# Scraper Configuration
SCRAPER_DELAY_MS=2000
SCRAPER_TIMEOUT=30000
SCRAPER_RETRY_ATTEMPTS=3

# NoBroker Configuration
NOBROKER_API_BASE=https://www.nobroker.in
NOBROKER_PAGES_TO_SCRAPE=5
NOBROKER_SEARCH_URL=https://www.nobroker.in/p/property-for-rent?city=gurugram

# 99acres Configuration
NINETY_NINE_ACRES_API_BASE=https://www.99acres.com
NINETY_NINE_ACRES_PAGES_TO_SCRAPE=5
NINETY_NINE_ACRES_SEARCH_URL=https://www.99acres.com/search/property/rent/in-gurugram

# Affiliate Configuration
AFFILIATE_NOBROKER_ID=your_affiliate_id
AFFILIATE_99ACRES_ID=your_affiliate_id
AFFILIATE_COMMISSION_NOBROKER=12
AFFILIATE_COMMISSION_99ACRES=10

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/scraper.log

# Scheduling
ENABLE_SCHEDULE=false
SCHEDULE_TIME=0 9 * * 5

# Admin Configuration
ADMIN_ID=admin@ggnhome.com
ADMIN_API_KEY=
